        }
      }
    },
    "Sentence %lld of %lld": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld文中の%1$lld文目"
          }
        }
      }
    },
    "Show Document Name on Lock Screen": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロック画面に文書名を表示"
          }
        }
      }
    },
    "SimpleTTS": {
      "shouldTranslate": false
    },
    "Some data could not be deleted. Please try again.\n%@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部のデータを削除できませんでした。もう一度お試しください。\n%@"
          }
        }
      }
    },
    "Speech Settings": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み上げ設定"
          }
        }
      }
    },
    "Speech speed": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み上げ速度"
          }
        }
      }
    },
    "Speech speed relative to the voice's normal rate (%@–%@)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "声の標準の速さに対する読み上げ速度（%@〜%@）"
          }
        }
      }
    },
    "Speech synthesis stopped responding.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声の合成が応答しなくなりました。"
          }
        }
      }
    },
    "Speed": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "速度"
          }
        }
      }
    },
    "Storage": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存"
          }
        }
      }
    },
    "System Default": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム既定の声"
          }
        }
      }
    },
    "The document identifier is invalid.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文書の識別子が不正です。"
          }
        }
      }
    },
    "The say command failed (exit code %d). Check your voice settings.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "say コマンドが異常終了しました（終了コード %d）。音声の設定を確認してください。"
          }
        }
      }
    },
    "The selected voice is not available on this device. Download it in Settings under Accessibility, or choose another voice.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した声がこの端末にありません。設定アプリの「アクセシビリティ」で追加するか、別の声を選んでください。"
          }
        }
      }
    },
    "The text for “%@” could not be found. Open the original file again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」の本文が見つかりません。ファイルを開き直してください。"
          }
        }
      }
    },
    "This document and its history will not be saved": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この文書の本文と履歴は保存しません"
          }
        }
      }
    },
    "This file could not be read as text.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルをテキストとして読み込めませんでした。"
          }
        }
      }
    },
    "Voice": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "声"
          }
        }
      }
    },
    "Voice and speed (currently %@, %@)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "声と速度（現在: %@、%@）"
          }
        }
      }
    },
    "Voice used for speech": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み上げに使う声"
          }
        }
      }
    },
    "When disabled, the title is shown as “SimpleTTS.” When enabled, the document name may also appear in Control Center and on connected devices.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフのときは「SimpleTTS」と表示します。オンにすると、コントロールセンターや接続先の機器にも文書名が表示されることがあります。"
          }
        }
      }
    },
    "When enabled, the app saves the full text, document name, an excerpt, reading position, and date. Turning this off keeps existing saved data. To save a document opened with saving disabled, enable this setting and reopen it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにすると、本文全体、文書名、本文の抜粋、読書位置、日時を保存します。オフにしても、以前の保存データは残ります。保存せずに開いた文書を保存する場合は、オンにしてから開き直してください。"
          }
        }
      }
    },
    "You can keep up to %lld saved positions. Delete a saved position to make room.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セーブは最大%lld件までです。不要なセーブを削除してください。"
          }
        }
      }
    },
    "Your position is saved here when you pause.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一時停止した位置がここに保存されます。"
          }
        }
      }
    },
    "“%@” has no text to read aloud.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」には読み上げる文章がありません。"
          }
        }
      }
    },
    "“%@” — sentence %lld": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」の%lld文目"
          }
        }
      }
    }
  },
  "version": "1.0"
}
