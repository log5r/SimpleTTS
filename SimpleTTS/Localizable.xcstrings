    "Document text and history: %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本文と履歴: %@"
          }
        }
      }
    },
    "Documents and history stay on your device. The app does not upload them to a server, and excludes its storage folder from system backups.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本文と履歴は端末内に保存します。サーバーへのアップロードは行わず、保存フォルダはシステムのバックアップ対象から除外します。"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了"
          }
        }
      }
    },
