{
  "sourceLanguage": "en",
  "strings": {
    "%@ (%@)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（%@）"
          }
        }
      }
    },
    "%@ Enhanced": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 拡張"
          }
        }
      }
    },
    "%@ Premium": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ プレミアム"
          }
        }
      }
    },
    "%lld / %lld": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld / %lld"
          }
        }
      }
    },
    "All saved data has been deleted.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存データをすべて削除しました。"
          }
        }
      }
    },
    "Automatic": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オートセーブ"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセル"
          }
        }
      }
    },
    "Cannot save because the storage location is a link or is not a regular folder.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存先にリンクまたは通常のフォルダではない項目があるため、保存できません。"
          }
        }
      }
    },
    "Choose Open File to select a .txt file.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ファイルを開く」から .txt ファイルを選んでください。"
          }
        }
      }
    },
    "Choose Save Position while paused to add one.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一時停止中に「セーブ」を押すと追加できます。"
          }
        }
      }
    },
    "Choose a plain text file.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレーンテキストのファイルを選んでください。"
          }
        }
      }
    },
    "Choose a regular text file. Folders and links cannot be opened.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通常のテキストファイルを選んでください。フォルダやリンクは開けません。"
          }
        }
      }
    },
    "Choose a text file no larger than 10 MiB.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "10 MiB 以下のテキストファイルを選んでください。"
          }
        }
      }
    },
    "Choose a text file on your device. Web URLs cannot be opened.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末上のテキストファイルを選んでください。Web の URL は開けません。"
          }
        }
      }
    },
    "Closes the current document and deletes stored documents, history, recovery copies, and generated audio. Original files, clipboard contents, and existing backups are not deleted.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の文書を閉じ、保存した本文、履歴、復旧用の退避ファイル、生成した音声を削除します。元ファイル、クリップボードの内容、既存のバックアップは削除しません。"
          }
        }
      }
    },
    "Copied the current sentence.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォーカス中の文章をコピーしました。"
          }
        }
      }
    },
    "Copy Sentence": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピー"
          }
        }
      }
    },
    "Copy the current sentence while paused (⇧⌘C)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一時停止中の文をコピー（⇧⌘C）"
          }
        }
      }
    },
    "Could not convert the generated audio.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "合成した音声を変換できませんでした。"
          }
        }
      }
    },
    "Could not convert the generated audio: %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "合成した音声を変換できませんでした: %@"
          }
        }
      }
    },
    "Could not delete the saved position: %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セーブを削除できませんでした: %@"
          }
        }
      }
    },
    "Could not load or move the saved data. Saving is disabled for this session to protect the original data: %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セーブデータを読み込めず、退避もできませんでした。元のデータを守るため、このセッションではセーブを書き込みません: %@"
          }
        }
      }
    },
    "Could not load saved positions. The original data has been moved to “%@”, and document text has been kept: %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セーブデータを読み込めませんでした。元のデータは「%@」に退避し、本文は保持しています: %@"
          }
        }
      }
    },
    "Could not load saved positions: %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セーブデータを読み込めませんでした: %@"
          }
        }
      }
    },
    "Could not open the file: %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルを開けませんでした: %@"
          }
        }
      }
    },
    "Could not read aloud: %@ (History will not be saved.)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み上げに失敗しました: %@（履歴は保存しません）"
          }
        }
      }
    },
    "Could not read aloud: %@ (Position auto-saved at sentence %lld.)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み上げに失敗しました: %@（%lld文目をオートセーブしました）"
          }
        }
      }
    },
    "Could not read aloud: %@ (The position also could not be auto-saved: %@)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み上げに失敗しました: %@（位置のオートセーブにも失敗しました: %@）"
          }
        }
      }
    },
    "Could not read the generated audio file.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "合成した音声ファイルを読み込めませんでした。"
